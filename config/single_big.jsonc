{
    "nodes": [
        {
            /* Warning: as the name is used for the attached database, it must follows the rules: */
            /* - https://duckdb.org/docs/current/sql/dialect/keywords_and_identifiers#database-names */
            /* - https://duckdb.org/docs/current/sql/dialect/keywords_and_identifiers#identifiers */
            "name": "single",
            "port": "9494",
            /* The node has both roles data and coordination */
            "roles": "md",
            /* Data node settings */
            "data_alias": "data",
            "data_source_type": "db",
            /* Requirement: the database ./data/big.db must be built. Use the script ./data/big.sh */
            "data_source": "big.db",
            /* Coordination node settings */
            "group_by": "item"
        }
    ]
}